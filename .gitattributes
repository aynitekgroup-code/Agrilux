# Normalización de finales de línea
# Fuerza LF en todo el repo, evitando conflictos CRLF/LF entre Windows y WSL
* text=auto eol=lf

# Scripts y configs que DEBEN ser LF
*.sh        text eol=lf
*.gradle    text eol=lf
*.properties text eol=lf
*.xml       text eol=lf
*.json      text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf
*.py        text eol=lf
gradlew     text eol=lf

# Scripts de Windows deben quedar CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binarios: Git no debe tocarlos
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.svg       text eol=lf
*.pdf       binary
*.apk       binary
*.aab       binary
*.jar       binary
*.so        binary
*.dll       binary
*.exe       binary
*.keystore  binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.mp4       binary
*.webm      binary
