# Agrilux - plantilla de variables de entorno
#
# Copia este archivo como .env.local para desarrollo:
#   cp env.example .env.local
#
# Nunca coloques valores reales aquí ni subas .env/.env.local al repositorio.
# Las variables con VITE_ se envían al navegador: solo deben contener valores
# públicos. Las demás son privadas y se configuran en Vercel como Environment
# Variables para las funciones de api/.

# ---------------------------------------------------------------------------
# Frontend: Supabase
# ---------------------------------------------------------------------------
# Proyecto Supabase > Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo para scripts de migración/administración. Nunca usar en el frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Solo lo consume el script legacy de migración. No debe existir en variables
# VITE de un despliegue público porque expone privilegios administrativos.
VITE_SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Frontend: aplicación y mapas
# ---------------------------------------------------------------------------
# Base opcional para llamadas a un backend separado. Vacío usa /api.
VITE_API_BASE_URL=

# Token público de Mapbox. Tiene restricciones por dominio en Mapbox.
VITE_MAPBOX_TOKEN=

# OAuth de Google usado por el panel de administración para Google Drive.
VITE_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Backend: autenticación y administración
# ---------------------------------------------------------------------------
# La API valida esta clave en /api/alertas-preventivas?type=auth y /api/tiendas.
ADMIN_KEY=

# Compatibilidad con el flujo anterior del frontend.
VITE_ADMIN_KEY=

# ---------------------------------------------------------------------------
# Backend: inteligencia artificial
# ---------------------------------------------------------------------------
# Se intenta en cascada según la función y disponibilidad.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Backend: diagnóstico de plantas
# ---------------------------------------------------------------------------
CROP_HEALTH_API_KEY=
PLANT_ID_API_KEY=
HUGGINGFACE_API_KEY=

# ---------------------------------------------------------------------------
# Backend: clima, suelo y datos satelitales
# ---------------------------------------------------------------------------
# Open-Meteo y SoilGrids funcionan sin clave y son los fallbacks gratuitos.
OPENWEATHER_API_KEY=
AGROMONITORING_API_KEY=
# Alias aceptado por algunas integraciones antiguas.
AGRO_API_KEY=

NASA_EARTHDATA_KEY=

# Sentinel Hub / Copernicus. Son opcionales; sin ellas se usa el fallback
# disponible en api/sentinel.js.
SENTINEL_INSTANCE_ID=
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Backend: búsqueda de insumos y tiendas
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# Backend: notas por WhatsApp
# ---------------------------------------------------------------------------
# Solo necesario si se habilita api/notas-whatsapp.js.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ---------------------------------------------------------------------------
# Migración legacy: Firebase
# ---------------------------------------------------------------------------
# Solo necesarios si se ejecutan los scripts de migración/exportación.
# La aplicación actual usa Supabase como almacenamiento principal.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Integraciones planificadas/no activas por defecto
# ---------------------------------------------------------------------------
# Mantener vacías hasta implementar el flujo de pagos correspondiente.
VITE_CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
VITE_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
