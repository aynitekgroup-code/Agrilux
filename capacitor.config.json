{
  "appId": "com.agrilux.app",
  "appName": "Agrilux",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#22C55E",
      "showSpinner": false
    },
    "Geolocation": {
      "highAccuracy": true
    },
    "Camera": {
      "androidPermissions": ["android.permission.CAMERA"]
    }
  }
}
